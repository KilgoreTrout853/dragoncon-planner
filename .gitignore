# Secrets - never commit
.env
*.key
anthropic_key.txt

# Local backups from setup
*.bak

# Node
node_modules/

# Python
__pycache__/
*.pyc

# Build output (vite build); the next deploy publishes it, main never builds
dist/
# The browser tests' second build, the page with a backend (tests/browser/serve.js)
dist-backend/

# What a run of the browser tests leaves: its report, and a failure's trace
playwright-report/
test-results/

# Third-party floor plans kept locally, never committed (reference/README.md)
reference/*
!reference/README.md

# What a person's tools write for their own inspection, never committed (tools/replay_changes_2026.py)
tools/out/
